<?xml version="1.0" encoding="utf-8"?>
<!--
    向导第二步：连接模型。
    ID 与 AuthFragment 一一对应，勿改名：
    auth_provider_group / provider_{deepseek,zhipu,minimax,openai,anthropic,gemini,custom} /
    auth_api_key / auth_model / auth_base_url / auth_custom_fields /
    btn_verify_key / auth_status，btn_toggle_key 为新增的明文切换。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="?attr/coomiPage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/coomi_gutter"
        android:paddingEnd="@dimen/coomi_gutter"
        android:paddingTop="@dimen/coomi_space_s"
        android:paddingBottom="@dimen/coomi_space_xl">

        <!-- ── 标题区 ── -->
        <TextView
            style="@style/Coomi.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/coomi_space_l"
            android:text="@string/coomi_auth_title"/>

        <TextView
            style="@style/Coomi.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/coomi_space_s"
            android:text="@string/coomi_auth_subtitle"/>

        <!-- ── 服务商 ── -->
        <TextView
            style="@style/Coomi.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/coomi_space_xl"
            android:text="@string/coomi_auth_section_provider"/>

        <RadioGroup
            android:id="@+id/auth_provider_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/provider_deepseek"
                style="@style/Coomi.ProviderCard"
                android:checked="true"
                android:text="@string/coomi_provider_deepseek"/>

            <RadioButton
                android:id="@+id/provider_zhipu"
                style="@style/Coomi.ProviderCard"
                android:layout_marginTop="@dimen/coomi_space_s"
                android:text="@string/coomi_provider_zhipu"/>

            <RadioButton
                android:id="@+id/provider_minimax"
                style="@style/Coomi.ProviderCard"
                android:layout_marginTop="@dimen/coomi_space_s"
                android:text="@string/coomi_provider_minimax"/>

            <RadioButton
                android:id="@+id/provider_openai"
                style="@style/Coomi.ProviderCard"
                android:layout_marginTop="@dimen/coomi_space_s"
                android:text="@string/coomi_provider_openai"/>

            <RadioButton
                android:id="@+id/provider_anthropic"
                style="@style/Coomi.ProviderCard"
                android:layout_marginTop="@dimen/coomi_space_s"
                android:text="@string/coomi_provider_anthropic"/>

            <RadioButton
                android:id="@+id/provider_gemini"
                style="@style/Coomi.ProviderCard"
                android:layout_marginTop="@dimen/coomi_space_s"
                android:text="@string/coomi_provider_gemini"/>

            <RadioButton
                android:id="@+id/provider_custom"
                style="@style/Coomi.ProviderCard"
                android:layout_marginTop="@dimen/coomi_space_s"
                android:text="@string/coomi_provider_custom"/>
        </RadioGroup>

        <!-- ── 凭据 ── -->
        <TextView
            style="@style/Coomi.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/coomi_space_xl"
            android:text="@string/coomi_auth_section_key"/>

        <TextView
            style="@style/Coomi.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/coomi_auth_key_label"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/auth_api_key"
                style="@style/Coomi.Input.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="50dp"
                android:hint="@string/coomi_auth_key_hint"
                android:inputType="textPassword"
                android:maxLines="1"/>

            <ImageButton
                android:id="@+id/btn_toggle_key"
                android:layout_width="@dimen/coomi_tap_target"
                android:layout_height="@dimen/coomi_tap_target"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="3dp"
                android:background="@drawable/coomi_bg_circle_ghost"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/coomi_ic_eye"
                android:tint="?attr/coomiText3"
                android:contentDescription="@string/coomi_auth_toggle_key"/>
        </FrameLayout>

        <TextView
            style="@style/Coomi.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/coomi_space_l"
            android:layout_marginBottom="6dp"
            android:text="@string/coomi_auth_model_label"/>

        <EditText
            android:id="@+id/auth_model"
            style="@style/Coomi.Input.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/coomi_auth_model_hint"
            android:inputType="text"
            android:maxLines="1"/>

        <Button
            android:id="@+id/btn_discover_models"
            style="@style/Coomi.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/coomi_button_height"
            android:layout_marginTop="@dimen/coomi_space_s"
            android:text="@string/coomi_auth_discover_models"/>

        <TextView
            style="@style/Coomi.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/coomi_space_l"
            android:layout_marginBottom="6dp"
            android:text="@string/coomi_auth_context_window_label"/>

        <Spinner
            android:id="@+id/auth_context_window"
            android:layout_width="match_parent"
            android:layout_height="@dimen/coomi_button_height"
            android:background="@drawable/coomi_bg_input"
            android:entries="@array/coomi_context_window_options"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:spinnerMode="dropdown"/>

        <!-- 仅「自定义」服务商时展开 -->
        <LinearLayout
            android:id="@+id/auth_custom_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Coomi.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/coomi_space_l"
                android:layout_marginBottom="6dp"
                android:text="@string/coomi_auth_base_url_label"/>

            <EditText
                android:id="@+id/auth_base_url"
                style="@style/Coomi.Input.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/coomi_auth_base_url_hint"
                android:inputType="textUri"
                android:maxLines="1"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_verify_key"
            style="@style/Coomi.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/coomi_button_height"
            android:layout_marginTop="@dimen/coomi_space_xl"
            android:text="@string/coomi_auth_verify"/>

        <TextView
            android:id="@+id/auth_status"
            style="@style/Coomi.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/coomi_space_m"
            android:gravity="center"
            android:text=""/>

    </LinearLayout>
</ScrollView>
