<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/coomiPage" android:fitsSystemWindows="true" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/coomi_gutter" android:paddingEnd="@dimen/coomi_gutter">
        <ImageButton android:id="@+id/btn_appearance_back" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/coomi_backup_back" android:src="@drawable/coomi_ic_back" android:tint="?attr/coomiText" />
        <TextView style="@style/Coomi.Text.Heading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/coomi_space_s" android:layout_weight="1" android:text="@string/coomi_appearance_title" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/coomi_gutter" android:paddingEnd="@dimen/coomi_gutter" android:paddingTop="@dimen/coomi_space_s" android:paddingBottom="@dimen/coomi_space_xl">
            <TextView style="@style/Coomi.Text.SectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="主题风格" />
            <LinearLayout style="@style/Coomi.Card">
                <LinearLayout android:id="@+id/btn_appearance_system" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><RadioButton android:id="@+id/radio_appearance_system" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="?attr/coomiBlue" android:clickable="false"/><TextView style="@style/Coomi.Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/coomi_dash_theme_system"/></LinearLayout>
                <View style="@style/Coomi.Divider"/><LinearLayout android:id="@+id/btn_appearance_light" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><RadioButton android:id="@+id/radio_appearance_light" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="?attr/coomiBlue" android:clickable="false"/><TextView style="@style/Coomi.Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/coomi_dash_theme_light"/></LinearLayout>
                <View style="@style/Coomi.Divider"/><LinearLayout android:id="@+id/btn_appearance_dark" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><RadioButton android:id="@+id/radio_appearance_dark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="?attr/coomiBlue" android:clickable="false"/><TextView style="@style/Coomi.Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/coomi_dash_theme_dark"/></LinearLayout>
                <View style="@style/Coomi.Divider"/><LinearLayout android:id="@+id/btn_appearance_book" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><RadioButton android:id="@+id/radio_appearance_book" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="?attr/coomiBlue" android:clickable="false"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Coomi.Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/coomi_dash_theme_book"/><TextView style="@style/Coomi.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/coomi_appearance_book_desc"/></LinearLayout></LinearLayout>
                <View style="@style/Coomi.Divider"/><LinearLayout android:id="@+id/btn_appearance_orange" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><RadioButton android:id="@+id/radio_appearance_orange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="?attr/coomiBlue" android:clickable="false"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Coomi.Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/coomi_dash_theme_orange"/><TextView style="@style/Coomi.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/coomi_appearance_orange_desc"/></LinearLayout></LinearLayout>
                <View style="@style/Coomi.Divider"/><LinearLayout android:id="@+id/btn_appearance_ink" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><RadioButton android:id="@+id/radio_appearance_ink" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="?attr/coomiBlue" android:clickable="false"/><TextView style="@style/Coomi.Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/coomi_dash_theme_ink"/></LinearLayout>
                <View style="@style/Coomi.Divider"/><LinearLayout android:id="@+id/btn_appearance_abyss" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><RadioButton android:id="@+id/radio_appearance_abyss" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="?attr/coomiBlue" android:clickable="false"/><TextView style="@style/Coomi.Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/coomi_dash_theme_abyss"/></LinearLayout>
                <View style="@style/Coomi.Divider"/><LinearLayout android:id="@+id/btn_appearance_ember" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><RadioButton android:id="@+id/radio_appearance_ember" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="?attr/coomiBlue" android:clickable="false"/><TextView style="@style/Coomi.Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/coomi_dash_theme_ember"/></LinearLayout>
                <View style="@style/Coomi.Divider"/><LinearLayout android:id="@+id/btn_appearance_celadon" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><RadioButton android:id="@+id/radio_appearance_celadon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="?attr/coomiBlue" android:clickable="false"/><TextView style="@style/Coomi.Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/coomi_dash_theme_celadon"/></LinearLayout>
                <View style="@style/Coomi.Divider"/><LinearLayout android:id="@+id/btn_appearance_linen" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><RadioButton android:id="@+id/radio_appearance_linen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="?attr/coomiBlue" android:clickable="false"/><TextView style="@style/Coomi.Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/coomi_dash_theme_linen"/></LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/section_saved_palettes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/Coomi.Text.SectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/coomi_space_l" android:text="已保存配色" />
                <LinearLayout android:id="@+id/container_saved_palettes" style="@style/Coomi.Card" />
            </LinearLayout>
            <TextView style="@style/Coomi.Text.SectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/coomi_space_l" android:text="自定义配色" />
            <LinearLayout style="@style/Coomi.Card">
                <LinearLayout style="@style/Coomi.Row"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Coomi.Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="启用自定义配色"/><TextView style="@style/Coomi.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="覆盖所选主题的界面颜色"/></LinearLayout><Switch android:id="@+id/switch_custom_colors" android:layout_width="wrap_content" android:layout_height="48dp" android:contentDescription="启用自定义配色" android:showText="false"/></LinearLayout>
                <LinearLayout android:id="@+id/container_custom_colors" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                <View style="@style/Coomi.Divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="16dp" android:paddingBottom="10dp">
                    <Button android:id="@+id/btn_save_custom_palette" style="@style/Coomi.Button.Secondary" android:layout_width="match_parent" android:layout_height="44dp" android:text="保存为主题配色（0/3）" />
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/Coomi.Text.SectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/coomi_space_l" android:text="界面背景" />
            <LinearLayout style="@style/Coomi.Card">
                <LinearLayout android:id="@+id/row_console_background" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Coomi.Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="控制台背景图"/><TextView android:id="@+id/txt_console_background" style="@style/Coomi.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="未设置"/></LinearLayout><ImageView android:layout_width="@dimen/coomi_icon_s" android:layout_height="@dimen/coomi_icon_s" android:src="@drawable/coomi_ic_chevron_right" android:tint="?attr/coomiText3" android:contentDescription="@null"/></LinearLayout>
                <View style="@style/Coomi.Divider"/>
                <LinearLayout android:id="@+id/row_chat_background" style="@style/Coomi.Row" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/Coomi.Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="会话界面背景图"/><TextView android:id="@+id/txt_chat_background" style="@style/Coomi.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="未设置"/></LinearLayout><ImageView android:layout_width="@dimen/coomi_icon_s" android:layout_height="@dimen/coomi_icon_s" android:src="@drawable/coomi_ic_chevron_right" android:tint="?attr/coomiText3" android:contentDescription="@null"/></LinearLayout>
                <View style="@style/Coomi.Divider"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/coomi_space_l">
                    <TextView style="@style/Coomi.Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="控制台遮罩强度"/><SeekBar android:id="@+id/seek_console_mask" android:layout_width="match_parent" android:layout_height="40dp" android:max="95" android:progressTint="?attr/coomiBlue" android:thumbTint="?attr/coomiBlue"/>
                    <TextView style="@style/Coomi.Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/coomi_space_s" android:text="会话界面遮罩强度"/><SeekBar android:id="@+id/seek_chat_mask" android:layout_width="match_parent" android:layout_height="40dp" android:max="95" android:progressTint="?attr/coomiBlue" android:thumbTint="?attr/coomiBlue"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/coomi_space_s" android:orientation="horizontal"><Button android:id="@+id/btn_remove_console_background" style="@style/Coomi.Button.Text" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="移除控制台图"/><Button android:id="@+id/btn_remove_chat_background" style="@style/Coomi.Button.Text" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="移除会话图"/></LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <Button android:id="@+id/btn_reset_appearance" style="@style/Coomi.Button.Secondary" android:layout_width="match_parent" android:layout_height="@dimen/coomi_button_height" android:layout_marginTop="@dimen/coomi_space_l" android:text="恢复默认外观"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
