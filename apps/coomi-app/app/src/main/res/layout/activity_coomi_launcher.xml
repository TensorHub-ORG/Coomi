<?xml version="1.0" encoding="utf-8"?>
<!--
    Coomi 启动引导 · 欢迎 + 权限
    白底、居中品牌区、白卡权限行、底部整宽蓝色 CTA。
    ID 与 CoomiLauncherActivity 一一对应，不可重命名。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/coomiPage"
    tools:context="app.coomi.CoomiLauncherActivity">

    <!-- ================= 阶段一：欢迎 / 权限 ================= -->
    <LinearLayout
        android:id="@+id/welcome_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/coomi_gutter"
                android:paddingEnd="@dimen/coomi_gutter">

                <!-- ── 品牌区 ── -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="52dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/coomi_hero_glow"/>

                    <ImageView
                        android:layout_width="@dimen/coomi_logo_hero"
                        android:layout_height="@dimen/coomi_logo_hero"
                        android:layout_gravity="center"
                        android:src="@drawable/coomi_logo"
                        android:contentDescription="@string/coomi_brand"/>
                </FrameLayout>

                <TextView
                    style="@style/Coomi.Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.02"
                    android:text="@string/coomi_launcher_title"/>

                <TextView
                    style="@style/Coomi.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="@string/coomi_launcher_subtitle"/>

                <!-- ── 权限小节 ── -->
                <TextView
                    style="@style/Coomi.Text.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="38dp"
                    android:text="@string/coomi_launcher_section_permission"/>

                <LinearLayout
                    style="@style/Coomi.Card"
                    android:background="@drawable/coomi_bg_card_outlined"
                    android:tag="coomi:card-outlined">

                    <!-- 通知权限 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/coomi_space_l"
                        android:paddingEnd="@dimen/coomi_space_m"
                        android:paddingTop="@dimen/coomi_space_l"
                        android:paddingBottom="@dimen/coomi_space_l">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/coomi_bg_icon_tile">

                            <ImageView
                                android:layout_width="@dimen/coomi_icon_m"
                                android:layout_height="@dimen/coomi_icon_m"
                                android:layout_gravity="center"
                                android:src="@drawable/coomi_ic_bell"
                                android:tint="?attr/coomiBlue"
                                android:contentDescription="@null"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/coomi_space_m"
                            android:layout_marginEnd="@dimen/coomi_space_s">

                            <TextView
                                style="@style/Coomi.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:text="@string/coomi_launcher_notification_title"/>

                            <TextView
                                style="@style/Coomi.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/coomi_launcher_notification_desc"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_notification_permission"
                            style="@style/Coomi.Button.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/coomi_bg_pill_permission"
                            android:textColor="@color/coomi_permission_text"
                            android:text="@string/coomi_allow"/>
                    </LinearLayout>

                    <View style="@style/Coomi.Divider"/>

                    <!-- 电池优化 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/coomi_space_l"
                        android:paddingEnd="@dimen/coomi_space_m"
                        android:paddingTop="@dimen/coomi_space_l"
                        android:paddingBottom="@dimen/coomi_space_l">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/coomi_bg_icon_tile">

                            <ImageView
                                android:layout_width="@dimen/coomi_icon_m"
                                android:layout_height="@dimen/coomi_icon_m"
                                android:layout_gravity="center"
                                android:src="@drawable/coomi_ic_battery"
                                android:tint="?attr/coomiBlue"
                                android:contentDescription="@null"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/coomi_space_m"
                            android:layout_marginEnd="@dimen/coomi_space_s">

                            <TextView
                                style="@style/Coomi.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:text="@string/coomi_launcher_battery_title"/>

                            <TextView
                                style="@style/Coomi.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/coomi_launcher_battery_desc"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_battery_permission"
                            style="@style/Coomi.Button.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/coomi_bg_pill_permission"
                            android:textColor="@color/coomi_permission_text"
                            android:text="@string/coomi_allow"/>
                    </LinearLayout>

                        <View style="@style/Coomi.Divider"/>

                        <!-- 开机自启 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/coomi_space_l"
                            android:paddingEnd="@dimen/coomi_space_m"
                            android:paddingTop="@dimen/coomi_space_l"
                            android:paddingBottom="@dimen/coomi_space_l">

                            <FrameLayout
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/coomi_bg_icon_tile">

                                <ImageView
                                    android:layout_width="@dimen/coomi_icon_m"
                                    android:layout_height="@dimen/coomi_icon_m"
                                    android:layout_gravity="center"
                                    android:src="@drawable/coomi_ic_clock"
                                    android:tint="?attr/coomiBlue"
                                    android:contentDescription="@null"/>
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="@dimen/coomi_space_m"
                                android:layout_marginEnd="@dimen/coomi_space_s">

                                <TextView
                                    style="@style/Coomi.Text.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textStyle="bold"
                                    android:text="@string/coomi_launcher_autostart_title"/>

                                <TextView
                                    style="@style/Coomi.Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="@string/coomi_launcher_autostart_desc"/>
                            </LinearLayout>

                        <Button
                            android:id="@+id/btn_autostart_permission"
                            style="@style/Coomi.Button.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/coomi_bg_pill_permission"
                            android:textColor="@color/coomi_permission_text"
                            android:text="@string/coomi_go_grant"/>
                        </LinearLayout>
                </LinearLayout>

                <!-- Root / Shizuku：可选权限条目（淡橙红提示色），布局与通知/电池条目一致 -->
                <LinearLayout
                    style="@style/Coomi.Card"
                    android:background="@drawable/coomi_bg_card_outlined"
                    android:tag="coomi:card-outlined"
                    android:layout_marginTop="@dimen/coomi_space_m">

                    <!-- Root 权限 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/coomi_space_l"
                        android:paddingEnd="@dimen/coomi_space_m"
                        android:paddingTop="@dimen/coomi_space_l"
                        android:paddingBottom="@dimen/coomi_space_l">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/coomi_bg_icon_tile">

                            <ImageView
                                android:layout_width="@dimen/coomi_icon_m"
                                android:layout_height="@dimen/coomi_icon_m"
                                android:layout_gravity="center"
                                android:src="@drawable/coomi_ic_shield"
                                android:tint="?attr/coomiBlue"
                                android:contentDescription="@null"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/coomi_space_m"
                            android:layout_marginEnd="@dimen/coomi_space_s">

                            <TextView
                                style="@style/Coomi.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:text="@string/coomi_root_title"/>

                            <TextView
                                style="@style/Coomi.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                android:text="@string/coomi_root_desc"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_root_permission"
                            style="@style/Coomi.Button.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/coomi_bg_pill_permission"
                            android:textColor="@color/coomi_permission_text"
                            android:text="@string/coomi_go_grant"/>
                    </LinearLayout>

                    <View style="@style/Coomi.Divider"/>

                    <!-- Shizuku 权限 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/coomi_space_l"
                        android:paddingEnd="@dimen/coomi_space_m"
                        android:paddingTop="@dimen/coomi_space_l"
                        android:paddingBottom="@dimen/coomi_space_l">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/coomi_bg_icon_tile">

                            <ImageView
                                android:layout_width="@dimen/coomi_icon_m"
                                android:layout_height="@dimen/coomi_icon_m"
                                android:layout_gravity="center"
                                android:src="@drawable/coomi_ic_key"
                                android:tint="?attr/coomiBlue"
                                android:contentDescription="@null"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/coomi_space_m"
                            android:layout_marginEnd="@dimen/coomi_space_s">

                            <TextView
                                style="@style/Coomi.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:text="@string/coomi_shizuku_title"/>

                            <TextView
                                style="@style/Coomi.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                android:text="@string/coomi_shizuku_desc"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_shizuku_permission"
                            style="@style/Coomi.Button.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/coomi_bg_pill_permission"
                            android:textColor="@color/coomi_permission_text"
                            android:text="@string/coomi_go_grant"/>
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    style="@style/Coomi.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/coomi_space_m"
                    android:layout_marginStart="@dimen/coomi_space_xs"
                    android:lineSpacingExtra="3sp"
                    android:text="@string/coomi_launcher_privacy"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/coomi_space_xl"/>
            </LinearLayout>
        </ScrollView>

        <!-- ── 底部 CTA ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/coomi_gutter"
            android:paddingEnd="@dimen/coomi_gutter"
            android:paddingTop="@dimen/coomi_space_m"
            android:paddingBottom="@dimen/coomi_space_xl">

            <Button
                android:id="@+id/btn_continue"
                style="@style/Coomi.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/coomi_button_height"
                android:enabled="false"
                android:text="@string/coomi_continue"/>

            <CheckBox
                android:id="@+id/check_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/coomi_space_m"
                android:buttonTint="?attr/coomiBlue"
                android:text="@string/coomi_terms_consent"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 阶段二：加载 / 路由 ================= -->
    <LinearLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/coomi_hero_glow"/>

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/coomi_logo"
                android:contentDescription="@string/coomi_brand"/>
        </FrameLayout>

        <ProgressBar
            style="@style/Coomi.Spinner"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="@dimen/coomi_space_xl"/>

        <TextView
            android:id="@+id/launcher_status_text"
            style="@style/Coomi.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/coomi_space_l"
            android:text="@string/coomi_starting"/>
    </LinearLayout>

</FrameLayout>
