<?xml version="1.0" encoding="utf-8"?>
<!--
    问题反馈与诊断二级页面：CoomiFeedbackActivity。
    紧凑分区设计：主动反馈 / 反馈设置 / 反馈记录 / 诊断信息 / 经验库。
    控件统一 32-40dp 高、13sp 字号（Coomi.Button.Compact / Coomi.SectionLabel）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/coomiPage"
    android:fitsSystemWindows="true"
    tools:context="app.coomi.CoomiFeedbackActivity">

    <!-- ── 顶栏 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/coomi_gutter"
        android:paddingEnd="@dimen/coomi_gutter">

        <ImageButton
            android:id="@+id/btn_feedback_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/coomi_ic_back"
            android:tint="?attr/coomiText"
            android:contentDescription="@string/coomi_backup_back"/>

        <TextView
            style="@style/Coomi.Text.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/coomi_feedback_page_title"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/coomi_gutter"
            android:paddingEnd="@dimen/coomi_gutter"
            android:paddingTop="10dp"
            android:paddingBottom="28dp">

            <!-- ── 主动反馈 ── -->
            <TextView
                style="@style/Coomi.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/coomi_feedback_section_compose"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/coomi_bg_card"
                android:padding="12dp">

                <RadioGroup
                    android:id="@+id/feedback_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/feedback_type_suggestion"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/coomi_bg_feedback_segment"
                        android:button="@null"
                        android:checked="true"
                        android:gravity="center"
                        android:textColor="@drawable/coomi_feedback_segment_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="@string/coomi_feedback_type_suggestion"/>

                    <RadioButton
                        android:id="@+id/feedback_type_issue"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/coomi_bg_feedback_segment"
                        android:button="@null"
                        android:gravity="center"
                        android:textColor="@drawable/coomi_feedback_segment_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="@string/coomi_feedback_type_issue"/>
                </RadioGroup>

                <EditText
                    android:id="@+id/feedback_message"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/coomi_bg_input"
                    android:gravity="top|start"
                    android:hint="@string/coomi_feedback_message_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="4000"
                    android:padding="10dp"
                    android:textSize="13.5sp"
                    android:scrollbars="vertical"
                    android:textColor="?attr/coomiText"
                    android:textColorHint="?attr/coomiText3"/>

                <EditText
                    android:id="@+id/feedback_contact"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/coomi_bg_input"
                    android:hint="@string/coomi_feedback_contact_hint"
                    android:inputType="textEmailAddress"
                    android:maxLength="200"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textSize="13.5sp"
                    android:singleLine="true"
                    android:textColor="?attr/coomiText"
                    android:textColorHint="?attr/coomiText3"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/feedback_add_images"
                        style="@style/Coomi.Button.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="@string/coomi_feedback_add_images"/>

                    <TextView
                        android:id="@+id/feedback_image_count"
                        style="@style/Coomi.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/coomi_feedback_no_images"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_feedback_submit"
                    style="@style/Coomi.Button.Compact.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/coomi_feedback_submit"/>

                <TextView
                    style="@style/Coomi.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/coomi_feedback_privacy"/>
            </LinearLayout>

            <!-- ── 反馈设置 ── -->
            <TextView
                style="@style/Coomi.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/coomi_feedback_sec_settings"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/coomi_bg_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Coomi.Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:text="@string/coomi_feedback_switch_master"/>

                        <TextView
                            style="@style/Coomi.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/coomi_feedback_switch_master_desc"/>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_feedback_master"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:buttonTint="?attr/coomiBlue"
                        android:showText="false"/>
                </LinearLayout>

                <View style="@style/Coomi.Divider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Coomi.Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:text="@string/coomi_feedback_switch_conversation"/>

                        <TextView
                            style="@style/Coomi.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/coomi_feedback_switch_conversation_desc"/>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_feedback_conversation"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:buttonTint="?attr/coomiBlue"
                        android:showText="false"/>
                </LinearLayout>

                <View style="@style/Coomi.Divider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Coomi.Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:text="@string/coomi_feedback_switch_experience"/>

                        <TextView
                            style="@style/Coomi.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/coomi_feedback_switch_experience_desc"/>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_feedback_experience"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:buttonTint="?attr/coomiBlue"
                        android:showText="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── 反馈记录 ── -->
            <TextView
                style="@style/Coomi.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/coomi_feedback_sec_records"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/coomi_bg_card"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txt_feedback_pending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textColor="?attr/coomiText"
                    android:text="@string/coomi_feedback_no_records"/>

                <TextView
                    android:id="@+id/txt_feedback_sent"
                    style="@style/Coomi.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_feedback_retry"
                        style="@style/Coomi.Button.Compact"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/coomi_feedback_retry_all"/>

                    <Button
                        android:id="@+id/btn_feedback_clear"
                        style="@style/Coomi.Button.Compact"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:text="@string/coomi_feedback_clear_records"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── 诊断信息 ── -->
            <TextView
                style="@style/Coomi.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/coomi_feedback_sec_diagnostics"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/coomi_bg_card"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txt_feedback_env"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="11.5sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/coomiText2"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_feedback_view_log"
                        style="@style/Coomi.Button.Compact"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/coomi_feedback_view_log"/>

                    <Button
                        android:id="@+id/btn_feedback_share_log"
                        style="@style/Coomi.Button.Compact"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:text="@string/coomi_feedback_share_log"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── 经验库 ── -->
            <TextView
                style="@style/Coomi.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/coomi_feedback_sec_experience"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/coomi_bg_card"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txt_experience_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/coomiText"
                    android:text="@string/coomi_experience_empty"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_experience_view"
                        style="@style/Coomi.Button.Compact"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/coomi_experience_view"/>

                    <Button
                        android:id="@+id/btn_experience_clear"
                        style="@style/Coomi.Button.Compact"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:text="@string/coomi_experience_clear"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
