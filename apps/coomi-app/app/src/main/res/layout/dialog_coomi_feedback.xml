<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="12dp">

    <TextView
        style="@style/Coomi.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/coomi_feedback_title" />

    <TextView
        style="@style/Coomi.Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="@string/coomi_feedback_intro" />

    <TextView
        style="@style/Coomi.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/coomi_feedback_type_label" />

    <RadioGroup
        android:id="@+id/feedback_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="0dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/feedback_type_suggestion"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/coomi_bg_feedback_segment"
            android:button="@null"
            android:checked="true"
            android:gravity="center"
            android:textColor="@drawable/coomi_feedback_segment_text"
            android:textStyle="bold"
            android:text="@string/coomi_feedback_type_suggestion" />

        <RadioButton
            android:id="@+id/feedback_type_issue"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/coomi_bg_feedback_segment"
            android:button="@null"
            android:gravity="center"
            android:textColor="@drawable/coomi_feedback_segment_text"
            android:textStyle="bold"
            android:text="@string/coomi_feedback_type_issue" />
    </RadioGroup>

    <EditText
        android:id="@+id/feedback_message"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/coomi_bg_input"
        android:gravity="top|start"
        android:hint="@string/coomi_feedback_message_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="4000"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="?attr/coomiText"
        android:textColorHint="?attr/coomiText3" />

    <EditText
        android:id="@+id/feedback_contact"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/coomi_bg_input"
        android:hint="@string/coomi_feedback_contact_hint"
        android:inputType="textEmailAddress"
        android:maxLength="200"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="?attr/coomiText"
        android:textColorHint="?attr/coomiText3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/coomi_bg_card_outlined"
        android:tag="coomi:card-outlined"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/feedback_add_images"
            android:layout_width="wrap_content"
            style="@style/Coomi.Button.Outline"
            android:layout_height="40dp"
            android:text="@string/coomi_feedback_add_images" />

        <TextView
            android:id="@+id/feedback_image_count"
            style="@style/Coomi.Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/coomi_feedback_no_images" />
    </LinearLayout>

    <TextView
        style="@style/Coomi.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"
        android:text="@string/coomi_feedback_privacy" />
</LinearLayout>
