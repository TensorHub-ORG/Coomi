<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/coomiCard"/>
            <corners android:radius="@dimen/coomi_radius_input"/>
            <stroke android:width="@dimen/coomi_stroke_thick" android:color="?attr/coomiBlue"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/coomiFill"/>
            <corners android:radius="@dimen/coomi_radius_input"/>
            <stroke android:width="@dimen/coomi_stroke" android:color="?attr/coomiFill"/>
        </shape>
    </item>
</selector>
