<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/coomiBlue" />
            <stroke android:width="1dp" android:color="?attr/coomiBlue" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/coomiCard" />
            <stroke android:width="1dp" android:color="?attr/coomiBorder" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
