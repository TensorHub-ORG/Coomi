<?xml version="1.0" encoding="utf-8"?>
<!-- 权限胶囊按钮：未授权=蓝色实心，已授权=绿色浅底（禁用态） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="?attr/coomiOkSoft"/>
            <corners android:radius="@dimen/coomi_radius_pill"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/coomiBlue"/>
            <corners android:radius="@dimen/coomi_radius_pill"/>
        </shape>
    </item>
</selector>
