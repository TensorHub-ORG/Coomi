<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33C77B1B">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/coomi_warn_soft"/>
            <corners android:radius="@dimen/coomi_radius_pill"/>
            <stroke android:width="@dimen/coomi_stroke" android:color="@color/coomi_warn"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/coomi_white"/>
            <corners android:radius="@dimen/coomi_radius_pill"/>
        </shape>
    </item>
</ripple>
