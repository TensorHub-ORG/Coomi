{
  "name": "@coomi/coomi-tool-lsp",
  "description": "Model-facing lsp tool over the Coomi LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coomi/coomi-desktop.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@coomi/coomi-invariants": "workspace:^",
    "@coomi/coomi-llm": "workspace:^",
    "@coomi/coomi-lsp": "workspace:^",
    "@coomi/coomi-system-prompt": "workspace:^",
    "@coomi/coomi-timeout": "workspace:^",
    "@coomi/coomi-tools": "workspace:^",
    "@coomi/cordis": "workspace:^"
  },
  "dependencies": {
    "@coomi/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@coomi/coomi-agent": "workspace:^",
    "@coomi/coomi-fs-local": "workspace:^",
    "@coomi/coomi-invariants": "workspace:^",
    "@coomi/coomi-llm": "workspace:^",
    "@coomi/coomi-lsp": "workspace:^",
    "@coomi/coomi-lsp-stdio": "workspace:^",
    "@coomi/coomi-session": "workspace:^",
    "@coomi/coomi-subprocess-local": "workspace:^",
    "@coomi/coomi-system-prompt": "workspace:^",
    "@coomi/coomi-timeout": "workspace:^",
    "@coomi/coomi-tool-call-timeout-policy": "workspace:^",
    "@coomi/coomi-tools": "workspace:^",
    "@coomi/cordis": "workspace:^"
  }
}
