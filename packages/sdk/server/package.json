{
  "name": "@coomi/coomi-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Coomi SDK clients",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coomi/coomi-desktop.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@coomi/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@coomi/coomi-agent": "workspace:^",
    "@coomi/coomi-invariants": "workspace:^",
    "@coomi/coomi-llm": "workspace:^",
    "@coomi/coomi-llm-deepseek": "workspace:^",
    "@coomi/coomi-scope": "workspace:^",
    "@coomi/coomi-sdk-protocol": "workspace:^",
    "@coomi/coomi-session": "workspace:^",
    "@coomi/coomi-subagent": "workspace:^",
    "@coomi/cordis": "workspace:^"
  },
  "devDependencies": {
    "@coomi/cordis-plugin-loader": "workspace:^",
    "@coomi/coomi-agent": "workspace:^",
    "@coomi/coomi-agent-spine-demo": "workspace:^",
    "@coomi/coomi-invariants": "workspace:^",
    "@coomi/coomi-llm": "workspace:^",
    "@coomi/coomi-llm-deepseek": "workspace:^",
    "@coomi/coomi-scope": "workspace:^",
    "@coomi/coomi-sdk-protocol": "workspace:^",
    "@coomi/coomi-session": "workspace:^",
    "@coomi/coomi-session-persistence-jsonl": "workspace:^",
    "@coomi/coomi-subagent": "workspace:^",
    "@coomi/cordis": "workspace:^"
  }
}
