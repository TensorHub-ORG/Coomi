{
  "name": "@coomi/coomi-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coomi/coomi-desktop.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@coomi/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@coomi/coomi-invariants": "workspace:^",
    "@coomi/coomi-llm": "workspace:^",
    "@coomi/coomi-output-retention": "workspace:^",
    "@coomi/coomi-session": "workspace:^",
    "@coomi/coomi-spill": "workspace:^",
    "@coomi/coomi-subprocess": "workspace:^",
    "@coomi/coomi-system-prompt": "workspace:^",
    "@coomi/coomi-timeout": "workspace:^",
    "@coomi/coomi-tools": "workspace:^",
    "@coomi/cordis": "workspace:^"
  },
  "devDependencies": {
    "@coomi/coomi-agent": "workspace:^",
    "@coomi/coomi-subprocess": "workspace:^",
    "@coomi/coomi-subprocess-local": "workspace:^",
    "@coomi/coomi-invariants": "workspace:^",
    "@coomi/coomi-llm": "workspace:^",
    "@coomi/coomi-output-retention": "workspace:^",
    "@coomi/coomi-session": "workspace:^",
    "@coomi/coomi-spill": "workspace:^",
    "@coomi/coomi-system-prompt": "workspace:^",
    "@coomi/coomi-timeout": "workspace:^",
    "@coomi/coomi-tools": "workspace:^",
    "@coomi/cordis": "workspace:^"
  }
}
