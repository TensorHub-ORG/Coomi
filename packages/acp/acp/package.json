{
  "name": "@coomi/coomi-acp",
  "description": "Automation-only Agent Client Protocol server for driving Coomi agents over JSON-RPC stdio",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coomi/coomi-desktop.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@coomi/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@coomi/coomi-agent": "workspace:^",
    "@coomi/coomi-invariants": "workspace:^",
    "@coomi/coomi-session": "workspace:^",
    "@coomi/coomi-user-approval": "workspace:^",
    "@coomi/cordis": "workspace:^"
  },
  "devDependencies": {
    "@coomi/coomi-agent": "workspace:^",
    "@coomi/coomi-agent-loop": "workspace:^",
    "@coomi/coomi-agent-loop-testkit": "workspace:^",
    "@coomi/coomi-invariants": "workspace:^",
    "@coomi/coomi-llm": "workspace:^",
    "@coomi/coomi-session": "workspace:^",
    "@coomi/coomi-tools": "workspace:^",
    "@coomi/coomi-user-approval": "workspace:^",
    "@coomi/cordis": "workspace:^"
  }
}
