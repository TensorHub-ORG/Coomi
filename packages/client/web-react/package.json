{
  "name": "@coomi/coomi-client-web-react",
  "description": "Shell-side React glue: createSlotRenderer, SessionProvider, bindSnapshotSelector (uSES bridge), useInvoke",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coomi/coomi-desktop.git",
    "directory": "packages/client/web-react"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@coomi/coomi-client-ui-slots": "workspace:^",
    "react": "^18.2.0",
    "use-sync-external-store": "1.2.0"
  },
  "peerDependencies": {
    "@coomi/coomi-invariants": "workspace:^",
    "@coomi/cordis": "workspace:^"
  },
  "devDependencies": {
    "@coomi/coomi-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@coomi/cordis": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ]
}
