# ---- Explicitly excluded directories ----
# Video transcripts and planning docs with private content
docs/视频文稿/

# External reference forks / large upstream sources (not part of the product)
references/

# ---- Gradle / Android build outputs ----
.gradle/
build/
**/build/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.zip
!apps/coomi-app/app/src/main/cpp/bootstrap-aarch64.zip

# Staged build payloads (regenerated by Gradle from apps/web and apps/coomi-rs)
apps/coomi-app/app/src/main/assets/web.zip
# jniLibs 整体是 Gradle 构建产物，不提交；仅保留 DeepSeek PoW 官方求解库
# （从官方 APK 提取，构建不会重新生成，必须入库）
apps/coomi-app/app/src/main/jniLibs/*
!apps/coomi-app/app/src/main/jniLibs/arm64-v8a/
apps/coomi-app/app/src/main/jniLibs/arm64-v8a/*
!apps/coomi-app/app/src/main/jniLibs/arm64-v8a/librscrypto.so

# ---- Rust ----
apps/coomi-rs/target/
*.log

# ---- Node / Web ----
apps/web/node_modules/
apps/web/dist/

# ---- Local configuration ----
local.properties
*.keystore
*.jks
*.key

# ---- IDE ----
.idea/
*.iml
.vscode/

# ---- Coomi runtime data ----
.coomi/
.runtime-v2-work/
runtime-v2-dist/

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db

# ---- Misc Windows artifacts ----
nul

# ---- Reasonix ----
.reasonix/
reasonix.toml

# ---- Other ----
docs/反馈整理/
.zcode/
docs/总结文档/
build_log*.txt
java_pid*.hprof
scripts/__pycache__/
__pycache__/
*.py[cod]
